# Окружение и сборка
.venv/
build/
build-*/
*.ekp
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp

# Исходные документы заказчика (ГБУ «Система 112», ДГОЧСиПБ) — в корне проекта.
# В репозиторий не кладутся: внутренние материалы заказчика и крупные бинарники.
# Всё, что из них нужно для работы, извлечено в data/ в машиночитаемом виде.
/*.pdf
/*.docx
/*.xlsx
/Вопросы ответы.txt

# Тексты материалов заказчика, извлечённые при разработке: инструкция пользователя АРМ-112 и ответы на
# вопросы команды. Программа их не использует — в публичный репозиторий и дистрибутив не входят.
/data/instr/
/data/customer/

# Снимки экранов АРМ-112 (памятка и живой стенд УМЦ) — внутренние материалы заказчика,
# хранятся только локально. Описание интерфейса по ним — docs/UI-SPEC.md.
docs/ui/

# локальные настройки Claude Code (запуск сервера в панели браузера)
.claude/

# данные сервера: база, резервные копии, кэш озвучки, журналы
/var/

# голоса piper (по 63 МБ): кладутся в data/voices при сборке дистрибутива, см. tools/fetch_voices.py
/data/voices/
# модель распознавания речи Vosk (88 МБ): кладётся в data/asr при сборке дистрибутива, см. tools/fetch_asr.py
/data/asr/vosk-model-*

# дистрибутивы для поставки (tools/make_dist.py)
/dist/
